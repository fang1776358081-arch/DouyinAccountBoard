{
  "name": "douyin-account-board",
  "productName": "抖音账号工作台",
  "version": "0.3.0",
  "description": "打开服务器上的抖音账号工作台",
  "author": "fang1776358081-arch",
  "main": "main.cjs",
  "scripts": {
    "dist": "electron-builder --win nsis zip --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "electron": "37.10.3",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "local.douyin.account.board",
    "productName": "抖音账号工作台",
    "asar": false,
    "files": [
      "**/*",
      "!test-*.cjs",
      "!dist/**"
    ],
    "win": {
      "icon": "board.ico",
      "target": [
        {"target": "nsis", "arch": ["x64"]},
        {"target": "zip", "arch": ["x64"]}
      ],
      "requestedExecutionLevel": "asInvoker",
      "artifactName": "DouyinAccountBoard-Portable-${version}.${ext}"
    },
    "nsis": {
      "artifactName": "DouyinAccountBoard-Setup-${version}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "抖音账号工作台",
      "unicode": true,
      "installerLanguages": ["zh_CN"],
      "displayLanguageSelector": false,
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "fang1776358081-arch",
        "repo": "DouyinAccountBoard"
      }
    ]
  }
}
